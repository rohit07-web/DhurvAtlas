# Project URL from Supabase > Connect
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Supabase publishable key (sb_publishable_...) or legacy anon key.
# The existing variable name is retained for compatibility.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Server-side only. Optional; uploads and manual review work without Gemini.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# No Supabase service-role key is required by the application workflow.
